{
  "name": "saml-test-server",
  "version": "1.1.0",
  "private": false,
  "description": "Test SAML 2.0 Identity Provider (IdP) for E2E tests",
  "keywords": [
    "e2e",
    "hono",
    "idp",
    "saml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/greeeg/saml-test-server"
  },
  "bin": {
    "saml-idp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE*"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "lefthook install || true && npm run build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@xmldom/xmldom": "^0.9.8",
    "commander": "^14.0.0",
    "hono": "^4.9.0",
    "picocolors": "^1.1.1",
    "xml-crypto": "^6.1.2",
    "xml-encryption": "^3.1.0",
    "xml-formatter": "^3.6.6",
    "xml-name-validator": "^5.0.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.20.0",
    "@types/node": "^22.0.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
